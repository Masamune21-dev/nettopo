# Salin berkas ini jadi .env lalu isi kuncinya:
#   cp .env.example .env
#
# .env TIDAK ikut masuk git, dan kunci ini tidak pernah sampai ke browser —
# dev server Vite yang menyisipkannya sebagai header Authorization di sisi
# server saat meneruskan permintaan ke endpoint AI.

# Alamat endpoint yang kompatibel OpenAI, tanpa garis miring di akhir.
# Contoh: gateway AI sendiri, layanan penyedia model, atau server lokal
# seperti Ollama (http://localhost:11434/v1).
AI_BASE_URL=https://endpoint-anda.example/v1

# Kunci API dari penyedia endpoint di atas.
#
# Saat deploy (mis. Vercel), isi dua variabel ini di Environment Variables —
# bukan lewat berkas ini. Sengaja tanpa awalan VITE_ supaya tidak ikut
# ter-bundle ke browser.
AI_API_KEY=

# Kode akses asisten AI (opsional, tapi WAJIB untuk deploy publik). Kalau
# diisi, setiap permintaan AI harus membawa kode ini — pengguna mengisinya
# sekali di kolom "Kode akses" pada dialog AI. Tanpa kode ini, siapa pun yang
# tahu alamat aplikasi bisa memakai kunci API di atas.
AI_ACCESS_CODE=

# Model bawaan saat aplikasi dibuka. Kosongkan saja kalau mau memilih sendiri
# dari daftar model yang muncul di aplikasi.
AI_DEFAULT_MODEL=
